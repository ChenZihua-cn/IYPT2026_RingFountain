FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldSet
{
    field       alpha.water;
}

regions
(
    // Water region (bottom half, z < 0.5)
    boxToCell
    {
        box (-0.25 -0.25 -0.1) (0.25 0.25 0.5);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

