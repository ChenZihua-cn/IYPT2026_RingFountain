FoamFile
{
    format      ascii;
    class       pointScalarField;
    location    "0";
    object      motionScale;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    bottom
    {
        type            calculated;
    }
    atmosphere
    {
        type            calculated;
    }
    walls
    {
        type            calculated;
    }
    ringSurface
    {
        type            calculated;
    }
}


