FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/sixDoFRigidBodyMotion";
    object      state;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Initial center of mass position [m]
// 5cm above water surface (z=0.3)
centreOfMass    (0 0 0.35);

// Initial orientation (rotation tensor)
// Identity matrix = no rotation
orientation     (1 0 0 0 1 0 0 0 1);

// Initial velocity [m/s]
// Zero initial velocity (free fall under gravity)
velocity        (0 0 0);

// Initial angular velocity [rad/s]
omega           (0 0 0);

// Mass of the ring [kg]
// For steel ring: density ~ 7850 kg/m³
// Volume = π*(R_outer² - R_inner²)*width
// R_outer = 0.05 m, R_inner = 0.045 m, width = 0.01 m
// Volume = π*(0.05² - 0.045²)*0.01 = π*(0.0025 - 0.002025)*0.01 = π*0.000475*0.01 = 1.49e-5 m³
// Mass = 7850 * 1.49e-5 = 0.117 kg
mass            0.117;

// Moment of inertia [kg·m²]
// For a thin ring about its diameter (I_xx = I_yy) and symmetry axis (I_zz):
// I_xx = I_yy = ½ M R²; I_zz = M R²
// R_avg = (0.05 + 0.045)/2 = 0.0475 m, M = 0.117 kg
// I_xx = I_yy = 0.5 * 0.117 * 0.0475² = 1.32e-4
// I_zz = 0.117 * 0.0475² = 2.64e-4
momentOfInertia (1.32e-4 1.32e-4 2.64e-4);

// Center of mass of the undeformed body
// Ring is centred at origin in its local coordinate system
centreOfMass0   (0 0 0);

// Orientation of the undeformed body
orientation0    (1 0 0 0 1 0 0 0 1);

// Initial acceleration [m/s²] (optional)
acceleration    (0 0 0);

// Initial angular acceleration [rad/s²] (optional)
alpha           (0 0 0);

// Report settings
report          on;
reportToFile    on;

// Relaxation factor for acceleration (0-1)
accelerationRelaxation 0.3;

// Damping factor for acceleration (0-1)
accelerationDamping    0.99;

// ************************************************************************* //