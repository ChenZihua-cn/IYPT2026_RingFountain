FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.1;

boundaryField
{
    bottom
    {
        type            epsilonWallFunction;
        value           nonuniform List<scalar> 0();
    }
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 0.1;
        value           uniform 0.1;
    }
    walls
    {
        type            epsilonWallFunction;
        value           uniform 0.1;
    }
    ringSurface
    {
        type            zeroGradient;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 0.1;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 0.1;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 0.1;
    }
}


