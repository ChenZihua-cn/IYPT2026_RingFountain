FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Scaling factor (convert to meters)
convertToMeters 1;

// Domain dimensions (cylindrical domain)
// Diameter: 0.5 m, Height: 1.0 m
// Water depth: 0.5 m (bottom half), Air: 0.5 m (top half)

// Vertices of a rectangular box (simplified cylindrical domain)
// We'll create a box and later use snappyHexMesh for cylindrical refinement
vertices
(
    // Bottom layer (z = 0)
    (-0.25 -0.25 0)    // 0
    ( 0.25 -0.25 0)    // 1
    ( 0.25  0.25 0)    // 2
    (-0.25  0.25 0)    // 3

    // Middle layer (z = 0.5, water surface)
    (-0.25 -0.25 0.5)  // 4
    ( 0.25 -0.25 0.5)  // 5
    ( 0.25  0.25 0.5)  // 6
    (-0.25  0.25 0.5)  // 7

    // Top layer (z = 1.0)
    (-0.25 -0.25 1.0)  // 8
    ( 0.25 -0.25 1.0)  // 9
    ( 0.25  0.25 1.0)  // 10
    (-0.25  0.25 1.0)  // 11
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (10 10 20) simpleGrading (1 1 1)   // Water region
    hex (4 5 6 7 8 9 10 11) (10 10 20) simpleGrading (1 1 1) // Air region
);

edges
(
);

boundary
(
    // Bottom wall (tank bottom)
    bottom
    {
        type wall;
        faces
        (
            (0 4 7 3)
            (0 1 5 4)
            (1 2 6 5)
            (2 3 7 6)
        );
    }

    // Top boundary (atmosphere)
    atmosphere
    {
        type patch;
        faces
        (
            (8 9 10 11)
        );
    }

    // Side walls (tank walls)
    walls
    {
        type wall;
        faces
        (
            (0 3 11 8)
            (1 0 8 9)
            (2 1 9 10)
            (3 2 10 11)
        );
    }
);

mergePatchPairs
(
);

