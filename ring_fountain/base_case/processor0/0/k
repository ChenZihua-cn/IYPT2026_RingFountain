FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    bottom
    {
        type            kqRWallFunction;
        value           uniform 0.01;
    }
    atmosphere
    {
        type            inletOutlet;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            kqRWallFunction;
        value           uniform 0.01;
    }
    ringSurface
    {
        type            kqRWallFunction;
        value           nonuniform List<scalar> 0();
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 0.01;
    }
    procBoundary0to2
    {
        type            processor;
        value           uniform 0.01;
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform 0.01;
    }
}


