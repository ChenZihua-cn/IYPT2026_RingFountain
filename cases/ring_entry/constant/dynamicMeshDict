FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mover
{
    type            motionSolver;

    libs            ("librigidBodyMeshMotion.so");

    motionSolver    rigidBodyMotion;

    rigidBodyMotionCoeffs
    {
        report          on;

        solver
        {
            type Newmark;
        }

        accelerationRelaxation 0.7;

        bodies
        {
            ring
            {
                type            sphere;
                parent          root;

                mass            0.117;
                radius          0.025;
                centreOfMass    (0 0 0);
                transform       (1 0 0 0 1 0 0 0 1) (0 0 0.35);

                joint
                {
                    type            composite;
                    joints
                    (
                        {
                            type Pz;
                        }
                    );
                }

                patches         (ringSurface);
                innerDistance    0.05;
                outerDistance    0.15;
            }
        }

        restraints
        {
            bottomWall
            {
                type            linearSpring;
                body            ring;
                anchor          (0 0 0);
                refAttachmentPt (0 0 0);
                stiffness       1000;
                damping         10;
                restLength      0;
            }
        }
    }
}

