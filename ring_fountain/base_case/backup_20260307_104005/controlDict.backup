     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     overInterDyMFoam;

solver          overInterDyMFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1.0;

deltaT          0.0001;

writeControl    adjustableRunTime;

writeInterval   0.01;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;
maxAlphaCo      0.5;

maxDeltaT       0.0005;

functions
{
    probes
    {
        type            probes;
        libs            ("libsampling.so");

        probeLocations
        (
            (0 0 0.05)
            (0 0 0.10)
            (0 0 0.15)
            (0 0 0.20)
            (0 0 0.25)
            (0 0 0.30)
            (0 0 0.35)
            (0 0 0.40)
            (0 0 0.45)
            (0 0 0.50)
        );

        fields         (alpha.water);
        writeControl   timeStep;
        writeInterval  10;
    }

    fountainSurface
    {
        type            surfaces;
        libs            ("libsampling.so");

        surfaceFormat   vtk;
        fields          (alpha.water p_rgh U);

        isoSurfaceField alpha.water;
        isoSurfaceValue 0.5;

        writeControl    timeStep;
        writeInterval   100;
    }

    forces
    {
        type            forces;
        libs            ("libforces.so");

        patches         (ringSurface);
        rho             rhoInf;
        rhoInf          1.2;
        CofR            (0 0 0);

        writeControl    timeStep;
        writeInterval   10;
    }

    sixDoFRigidBodyState
    {
        type            sixDoFRigidBodyState;
        libs            ("libsixDoFRigidBodyMotion.so");

        writeControl    timeStep;
        writeInterval   10;
    }
}

// ************************************************************************* //