FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    // Water region (bottom half, z < 0.3)
    boxToCell
    {
        box (-0.15 -0.15 0) (0.15 0.15 0.3);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

