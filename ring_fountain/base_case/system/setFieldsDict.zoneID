FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict.zoneID;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue zoneID 0
);

regions
(
    cellToCell
    {
        set ringCells;  // topoSet创建的cellSet
        fieldValues
        (
            volScalarFieldValue zoneID 1
        );
    }
);

// ************************************************************************* //
