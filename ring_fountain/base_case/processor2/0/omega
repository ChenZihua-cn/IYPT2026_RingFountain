FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 10;

boundaryField
{
    bottom
    {
        type            omegaWallFunction;
        value           nonuniform List<scalar> 0();
    }
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 10;
        value           uniform 10;
    }
    walls
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
    ringSurface
    {
        type            omegaWallFunction;
        value           uniform 10;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 10;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 10;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 10;
    }
}


