FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    // Water drops falling from above (top region)
    boxToCell
    {
        box (-0.05 -0.05 0.8) (0.05 0.05 1.0);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

