FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // Create cell set for the ring region (overset region)
    {
        name    ringCells;
        type    cellSet;
        action  new;
        source  surfaceToCell;
        sourceInfo
        {
            file "ring.stl";
            nearDistance 0.01;
            curvature 100;
        }
    }

    // Create cell zone from cell set
    {
        name    ringZone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set ringCells;
        }
    }

    // Create background cell set (everything not in ringZone)
    {
        name    backgroundCells;
        type    cellSet;
        action  new;
        source  all;
    }

    // Subtract ring cells from background
    {
        name    backgroundCells;
        type    cellSet;
        action  subtract;
        source  setToCell;
        sourceInfo
        {
            set ringCells;
        }
    }

    // Create background cell zone
    {
        name    backgroundZone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set backgroundCells;
        }
    }
);

